# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
#  YuviPep AI Sales Platform â€” Configuration
#  Paste your keys here. Anything left blank degrades gracefully:
#  email/WhatsApp fall back to DRY-RUN mode (messages are composed, queued,
#  logged and saved to disk instead of actually sent) until credentials exist.
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€ Application â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
APP_NAME="YuviPep AI Sales Platform"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
# IMPORTANT: change this to a long random string in production.
SECRET_KEY=change-me-to-a-long-random-secret-key-for-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# â”€â”€ Platform Super Admin (created automatically on first startup) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SUPER_ADMIN_EMAIL=superadmin@platform.local
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Default: SQLite (zero setup â€” a ./data folder is created automatically).
# For production PostgreSQL:  postgresql+asyncpg://user:pass@localhost:5432/salesai
# (then also run scripts/postgres_rls.sql to enable Row-Level Security)
DATABASE_URL=sqlite+aiosqlite:///./data/salesplatform.db

# â”€â”€ File storage (audio, business cards, proposals) â€” per-org subfolders â”€â”€â”€â”€â”€â”€
STORAGE_DIR=./data/storage

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
#  AI MODEL LAYER  (LiteLLM-style switch: Gemini now, Claude later)
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# Switch provider with one line: gemini | claude
LLM_PROVIDER=gemini

GEMINI_API_KEY=paste-your-gemini-key-here
# Claude (for the later switch) â€” paste key and set LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Model tiers: cheap/fast model for simple steps, strong model for proposals.
LLM_MODEL_FAST=gemini-2.5-flash-lite
LLM_MODEL_STRONG=gemini-2.5-flash
# Claude equivalents used when LLM_PROVIDER=claude
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_STRONG=claude-sonnet-5

# ── Speech-to-text ─────────────────────────────────────────────────────────────
# STT_PROVIDER: whisper_local -> open-source Whisper on THIS machine (default).
#                               Audio never leaves the server; no key, no quota.
#                               Needs `pip install openai-whisper` + ffmpeg on
#                               PATH; first use downloads the model file to
#                               ~/.cache/whisper (medium = ~1.4 GB).
#               gemini        -> Google audio understanding via GEMINI_API_KEY
STT_PROVIDER=whisper_local
# tiny | base | small | medium | large - bigger = more accurate but slower
WHISPER_MODEL=medium
# Model for POST /api/v1/dictate (speaking into a text field in the app).
# Deliberately smaller than WHISPER_MODEL: a person is waiting on this one.
# Step up to base/small if names and jargon come back mangled.
# Dictation ran tiny until 21 Sep 2026, when a spoken client name came back
# as Russian. Same model name as VOICE_STT_MODEL means one shared GPU copy.
DICTATION_WHISPER_MODEL=large-v3

# ── Memory embeddings (semantic note search) ──────────────────────────────────
# EMBEDDING_PROVIDER: local  -> a sentence-transformers model on THIS machine
#                              (default). No key, no quota, no per-call cost,
#                              and a client's notes never leave the server.
#                              Needs `pip install sentence-transformers`; the
#                              model downloads to the HuggingFace cache on first
#                              use (~1.1 GB), the same deal as Whisper's.
#                     gemini -> Google's embedding API via GEMINI_API_KEY.
#                     hash   -> deterministic offline embedder (no semantics).
#                              Chosen automatically when LLM_PROVIDER=stub.
EMBEDDING_PROVIDER=local
# Picked on a measured bake-off against the real note corpus, not on reputation.
# The decisive axis was Indic scripts: an English-only tokeniser turns Kannada
# into [UNK] tokens, so all-MiniLM-L6-v2 and the bge-*-en models score 0/6 on
# Kannada questions while this one scores 5/6 (and 26/33 overall).
# A local filesystem path also works, for an install with no internet.
EMBEDDING_MODEL_LOCAL=intfloat/multilingual-e5-base
# This family is asymmetric — stored text and search text take different
# prefixes, and the two must agree or stored notes stop matching queries.
# Blank both if you switch to a symmetric model.
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# CPU on purpose: the GPU belongs to Whisper (~5 GB at medium, ~10 GB at large).
# Embedding costs ~8 ms on CPU, so there is nothing to win by competing for it.
EMBEDDING_DEVICE=cpu
# Used only when EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Cost / rate controls
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=4
LLM_DEFAULT_ORG_MONTHLY_BUDGET_USD=50.0

# ── Assistant conversation memory ────────────────────────────────────────────
# How much of the current chat the assistant sees before answering. Turns are
# plain text (never tool calls or ids), so the cost is small; the char budget
# is the hard ceiling that keeps a long chat from crowding out the system
# prompt on a small model. MAX_TURNS bounds one conversation; RETENTION_DAYS
# is the retention sweep — a chat buffer must not become a permanent store.
ASSISTANT_HISTORY_TURNS=12
ASSISTANT_HISTORY_CHAR_BUDGET=6000
ASSISTANT_SESSION_MAX_TURNS=60
ASSISTANT_HISTORY_RETENTION_DAYS=90

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
#  EMAIL SENDING (Gmail app passwords over SMTP)
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# EMAIL_MODE: dry_run  -> emails are fully composed and saved to disk (no send)
#             smtp     -> emails really send via SMTP below
EMAIL_MODE=dry_run
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Fallback sender when a user has no personal app password stored.
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_DEFAULT_USERNAME=
SMTP_DEFAULT_APP_PASSWORD=
# Sending pace (protects against provider rate limits)
EMAIL_MAX_PER_MINUTE=10

# ── Inbound email (IMAP poller) ────────────────────────────────────────────────
# INBOUND_EMAIL_MODE: off  -> school replies arrive only via POST /inbound/ingest
#                     imap -> each org's inbox is polled every INBOUND_POLL_SECONDS
#                             and new mail is fed to the Inbound Engine.
# Credentials: the org's email integration (PUT /api/v1/admin/integrations/email)
# — the same Gmail App Password used for sending also works for IMAP reading.
INBOUND_EMAIL_MODE=off
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
INBOUND_POLL_SECONDS=120

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
#  WHATSAPP (Meta WhatsApp Business Cloud API)
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# WHATSAPP_MODE: dry_run | cloud_api
WHATSAPP_MODE=dry_run
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_MAX_PER_MINUTE=10
# Token used to verify inbound status webhooks from Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-webhook-verify

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
#  GOOGLE CALENDAR (optional â€” internal scheduling always works without it)
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# CALENDAR_MODE: off | google
CALENDAR_MODE=off
# Path to a Google service-account JSON file with Calendar API enabled
GOOGLE_CALENDAR_CREDENTIALS_FILE=
# Calendar ID to write events into (e.g. yourteam@group.calendar.google.com)
GOOGLE_CALENDAR_ID=
# Reusable Google Meet link stamped into demo invites (create once at
# meet.google.com -> "Create a meeting for later"; orgs can override via
# PUT /api/v1/admin/integrations/calendar "meet_link")
GOOGLE_MEET_LINK=

# â”€â”€ Background jobs â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
JOB_WORKERS=3
JOB_MAX_ATTEMPTS=4

# â”€â”€ Data protection defaults (each org can override in its settings) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DEFAULT_AUDIO_RETENTION_DAYS=90
DEFAULT_TRANSCRIPT_RETENTION_DAYS=365

# ── Jarvis: confirmations and voice mode ─────────────────────────────────────
# See docs/JARVIS_VOICE_AND_CLIENT_CREATION_ANDROID.md. All optional; these
# are the defaults.
# How long a read-back ("Shall I add it?") waits for the person's yes.
ASSISTANT_CONFIRMATION_TTL_SECONDS=600
VOICE_MODE_ENABLED=true
# Whisper model for live voice turns. large-v3 heard 82% of names right on real
# recordings (turbo 74%) for ~0.25 s more per turn; turbo is the faster choice.
VOICE_STT_MODEL=large-v3
# Languages a voice turn may be heard in (Whisper codes); empty = any.
VOICE_STT_LANGUAGES=en,hi,kn
# Store Whisper weights as float16 on a GPU: same transcripts, half the memory.
WHISPER_FP16_WEIGHTS=true
# kokoro (needs `pip install kokoro soundfile`) | off (the phone speaks replies)
VOICE_TTS_ENGINE=kokoro
VOICE_TTS_VOICE=af_heart
VOICE_TTS_DEVICE=cuda
VOICE_VAD_SILENCE_MS=900
# Less sound than this is noise, not a turn (300 dropped a short "Yes.").
VOICE_MIN_UTTERANCE_MS=150
VOICE_MAX_UTTERANCE_SECONDS=30
VOICE_IDLE_TIMEOUT_SECONDS=300
VOICE_BARGE_IN=true
# A spoken yes/no to a waiting read-back may clear this lower confidence bar.
VOICE_CONFIRMATION_MIN_CONFIDENCE=0.4
