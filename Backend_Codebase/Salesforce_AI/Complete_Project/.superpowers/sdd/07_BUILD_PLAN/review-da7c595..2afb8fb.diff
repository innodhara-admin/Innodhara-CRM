+@router.delete("/vendors/{vendor_id}")
+async def delete_vendor(
+    vendor_id: str,
+    ctx: OrgContext = Depends(require_permission("manage_settings")),
+    db: AsyncSession = Depends(get_db),
+):
+    """action_items.external_wait is a JSON blob no foreign key can reach, so
+    the reference check is an explicit scan (04_OPEN_QUESTIONS.md Q5).
+
+    The scan matches on `vendor_name`, not `vendor_id`: the only route that
+    ever writes this blob (`POST /tasks/{id}/vendor-promise`) records a free
+    -text vendor name, never the catalogue row's id — the `vendor_id` key
+    named in the model's own docstring comment is aspirational and is never
+    actually produced. `vendor_id` is still checked too, defensively, in case
+    a future writer starts producing it (mirrors the same defensive read
+    already in `sync_engine.py`)."""
+    row = (
+        await db.execute(
+            select(Vendor).where(Vendor.id == vendor_id, Vendor.org_id == ctx.org_id)
+        )
+    ).scalar_one_or_none()
+    if row is None:
+        raise NotFoundError("Vendor not found")
+
+    waiting = (
+        await db.execute(
+            select(ActionItem).where(
+                ActionItem.org_id == ctx.org_id,
+                ActionItem.external_wait.is_not(None),
+            )
+        )
+    ).scalars().all()
+    blockers = [
+        t for t in waiting
+        if (t.external_wait or {}).get("vendor_id") == vendor_id
+        or (t.external_wait or {}).get("vendor_name") == row.name
+    ]
+    if blockers:
+        raise ConflictError(
+            f"{len(blockers)} task(s) are waiting on '{row.name}'. "
+            f"Clear those before removing the vendor."
+        )
+
+    await db.delete(row)
+    await audit_service.record(
+        db, org_id=ctx.org_id, user_id=ctx.user_id, action="ops.vendor_deleted",
+        entity_type="vendor", entity_id=vendor_id, detail={"name": row.name},
+    )
+    await db.commit()
+    return {"deleted": True}
+
