# ── Assistant conversation memory ────────────────────────────────────────────
# How much of the current chat the assistant sees before answering. Turns are
# plain text (never tool calls or ids), so the cost is small; the char budget
# is the hard ceiling that keeps a long chat from crowding out the system
# prompt on a small model. MAX_TURNS bounds one conversation; RETENTION_DAYS
# is the retention sweep — a chat buffer must not become a permanent store.
ASSISTANT_HISTORY_TURNS=12
ASSISTANT_HISTORY_CHAR_BUDGET=6000
ASSISTANT_SESSION_MAX_TURNS=60
ASSISTANT_HISTORY_RETENTION_DAYS=90

