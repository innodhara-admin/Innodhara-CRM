# ── Salesforce AI backend — runtime configuration ────────────────────────────
# Sourced by restart_backend.sh and healthcheck.sh. Edit here, not in the
# scripts.

# Where the frozen backend lives (contains run.py, app/, .venv/).
APP_DIR="/home/telaverge/Ekaghni/Salesforce_AI_Project/Backend_Codebase/Salesforce_AI/Complete_Project"

# Port the backend binds. NOT 8000: that is held by the unrelated
# yuvipep_learning_platform_chatbot service. app/config.py reads PORT from the
# environment and pydantic-settings gives it precedence over .env, so this
# needs no code change in the frozen tree.
PORT="8010"

# ── ngrok ────────────────────────────────────────────────────────────────────
NGROK_ENABLED="true"

# The tunnel points at nginx (/etc/nginx/sites-available/salesforce-public),
# not at the backend directly, so one public URL serves both the API and the
# download page:
#     https://<domain>/download/  -> APK + product manual (static)
#     https://<domain>/...        -> proxied to the backend on $PORT
# Set this to $PORT to bypass nginx and expose the backend alone again.
NGROK_TARGET_PORT="8080"

# The account's single free development domain. A free ngrok plan includes
# exactly ONE domain, so this is the same hostname the learning-platform
# chatbot used to publish on port 8000. Pointing it here means the chatbot
# keeps running locally but is no longer reachable from the internet — a
# deliberate choice, not an accident. Set NGROK_ENABLED=false to undo.
NGROK_DOMAIN="unaltered-uncommon-bottling.ngrok-free.dev"

# Local inspection API. ngrok picks 4040 by default and falls forward to 4041
# if something already holds it; pinning it keeps URL discovery deterministic.
NGROK_WEB_ADDR="127.0.0.1:4040"

# ── Health checking ──────────────────────────────────────────────────────────
HEALTH_PATH="/health"

# Seconds to wait for the backend to answer /health after launch. Startup runs
# init_db, seeds the super admin, starts the job queue and warms the Whisper
# dictation model, so allow generous time on a cold boot.
BACKEND_START_TIMEOUT="180"

# Seconds to wait for ngrok to report a public URL.
NGROK_START_TIMEOUT="60"
